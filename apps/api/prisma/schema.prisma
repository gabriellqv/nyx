datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SystemHealth {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("system_health")
}

model Customer {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  documentNumber String    @unique @map("document_number")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  accounts       Account[]
  user           User?

  @@map("customers")
}

model Account {
  id            String   @id @default(uuid())
  customerId    String   @map("customer_id")
  accountNumber String   @unique @map("account_number")
  currency      String   @db.VarChar(3)
  type          String   @default("checking")
  status        String   @default("active")
  balance       BigInt   @default(0)
  version       Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer          Customer       @relation(fields: [customerId], references: [id])
  ledgerEntries     LedgerEntry[]
  deposits          Deposit[]
  outgoingTransfers Transfer[]     @relation("SourceAccount")
  incomingTransfers Transfer[]     @relation("DestinationAccount")
  payments          Payment[]

  @@index([customerId])
  @@index([status])
  @@map("accounts")
}

model LedgerTransaction {
  id            String        @id @default(uuid())
  description   String
  referenceType String        @map("reference_type")
  referenceId   String?       @map("reference_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  entries       LedgerEntry[]

  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

model LedgerAccount {
  id          String   @id @default(uuid())
  code        String
  name        String
  currency    String   @db.VarChar(3)
  accountType String   @default("asset") @map("account_type")
  createdAt   DateTime @default(now()) @map("created_at")

  entries LedgerEntry[]

  @@unique([code, currency])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id              String   @id @default(uuid())
  transactionId   String   @map("transaction_id")
  accountId       String?  @map("account_id")
  ledgerAccountId String?  @map("ledger_account_id")
  entryType       String   @map("entry_type")
  amount         BigInt
  currency        String   @db.VarChar(3)
  sequenceNumber  Int      @map("sequence_number")
  createdAt       DateTime @default(now()) @map("created_at")

  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       Account?          @relation(fields: [accountId], references: [id])
  ledgerAccount LedgerAccount?    @relation(fields: [ledgerAccountId], references: [id])

  @@unique([transactionId, sequenceNumber])
  @@index([accountId])
  @@index([ledgerAccountId])
  @@index([transactionId])
  @@map("ledger_entries")
}

model Transfer {
  id                   String    @id @default(uuid())
  idempotencyKey       String    @unique @map("idempotency_key")
  requestHash          String?   @map("request_hash")
  sourceAccountId      String    @map("source_account_id")
  destinationAccountId String    @map("destination_account_id")
  amount               BigInt
  currency             String    @db.VarChar(3)
  status               String    @default("pending")
  description          String?
  failureReason        String?   @map("failure_reason")
  createdAt            DateTime  @default(now()) @map("created_at")
  completedAt          DateTime? @map("completed_at")

  sourceAccount        Account   @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount   Account   @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  reversal              TransferReversal?

  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([status])
  @@map("transfers")
}

model TransferReversal {
  id             String   @id @default(uuid())
  transferId     String   @unique @map("transfer_id")
  idempotencyKey String   @unique @map("idempotency_key")
  requestHash    String   @map("request_hash")
  reason         String
  createdAt      DateTime @default(now()) @map("created_at")

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Restrict)

  @@map("transfer_reversals")
}

model Deposit {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique @map("idempotency_key")
  requestHash    String   @map("request_hash")
  accountId      String   @map("account_id")
  amount         BigInt
  currency       String   @db.VarChar(3)
  description    String?
  responseBody   String   @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@map("deposits")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         String    @default("user")
  customerId   String?   @unique @map("customer_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  customer     Customer? @relation(fields: [customerId], references: [id])

  @@map("users")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  @map("actor_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  ipAddress    String?  @map("ip_address")
  details      String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([resourceType, resourceId])
  @@index([actorId])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid())
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       String
  status        String    @default("pending")
  retryCount    Int       @default(0) @map("retry_count")
  maxRetries    Int       @default(5) @map("max_retries")
  nextRetryAt   DateTime  @default(now()) @map("next_retry_at")
  errorMessage  String?   @map("error_message")
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")

  deliveries    WebhookDelivery[]

  @@index([status, nextRetryAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model WebhookEndpoint {
  id          String   @id @default(uuid())
  url         String
  secret      String
  events      String[]
  status      String   @default("active")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  deliveries  WebhookDelivery[]

  @@index([status])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id            String    @id @default(uuid())
  endpointId    String    @map("endpoint_id")
  outboxEventId String    @map("outbox_event_id")
  statusCode    Int?      @map("status_code")
  status        String    @default("pending")
  attempts      Int       @default(1)
  durationMs    Int?      @map("duration_ms")
  responseBody  String?   @map("response_body")
  createdAt     DateTime  @default(now()) @map("created_at")

  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  outboxEvent   OutboxEvent     @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([outboxEventId])
  @@index([status])
  @@map("webhook_deliveries")
}

model Payment {
  id                   String    @id @default(uuid())
  idempotencyKey       String    @unique @map("idempotency_key")
  requestHash          String?   @map("request_hash")
  destinationAccountId String    @map("destination_account_id")
  amount               BigInt
  currency             String    @db.VarChar(3)
  method               String
  status               String    @default("pending")
  description          String?
  createdAt            DateTime  @default(now()) @map("created_at")
  completedAt          DateTime? @map("completed_at")

  destinationAccount   Account   @relation(fields: [destinationAccountId], references: [id])

  @@index([destinationAccountId])
  @@index([status])
  @@map("payments")
}

model ReconciliationLog {
  id                      String   @id @default(uuid())
  totalAccountsAudited    Int      @map("total_accounts_audited")
  balancedAccountsCount   Int      @map("balanced_accounts_count")
  discrepantAccountsCount Int      @map("discrepant_accounts_count")
  status                  String   @default("balanced")
  details                 String
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("reconciliation_logs")
}
