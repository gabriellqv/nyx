{
  "name": "@nyx/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "admin:create": "node --env-file-if-exists=../../.env scripts/create-admin.mts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/throttler": "^6.7.1",
    "@nyx/contracts": "workspace:*",
    "@prisma/client": "^6.4.1",
    "bcrypt": "^5.1.1",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.2.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^6.4.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.8.3"
  }
}
