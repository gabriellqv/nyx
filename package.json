{
  "name": "nyx",
  "version": "0.1.0",
  "private": true,
  "description": "Financial infrastructure platform modeling double-entry ledger, atomic transfers, and robust financial correctness.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "dev": "pnpm --recursive --parallel run dev",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --ignore-path .prettierignore --ignore-path .git/info/exclude --write .",
    "format:check": "prettier --ignore-path .prettierignore --ignore-path .git/info/exclude --check .",
    "prepare": "husky",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:reset": "docker compose down -v && docker compose up -d"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "26.6.6",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.72.2"
  }
}
