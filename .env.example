# Application runtime environment
NODE_ENV=development
PORT=3001

# Database connection
POSTGRES_USER=nyx_user
POSTGRES_PASSWORD=nyx_password
POSTGRES_DB=nyx_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nyx_user:nyx_password@localhost:5432/nyx_dev?schema=public
JWT_SECRET=local-development-secret-change-before-production
# Local example only. Use a private key from secrets storage in production.
WEBHOOK_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend and CORS configuration
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Initial local administrator provisioning
NYX_ADMIN_NAME=Local Administrator
NYX_ADMIN_EMAIL=admin@nyx.local
NYX_ADMIN_PASSWORD=change-this-local-password
